loadstring([[
local plr = game.Players.LocalPlayer
local char = plr.Character or plr.CharacterAdded:Wait()
local root = char:WaitForChild("HumanoidRootPart")
local UIS = game:GetService("UserInputService")
local RS = game:GetService("RunService")

local fly = false
local speed = 60
local bv, bg

local function toggleFly(state)
    if state then
        if bv then bv:Destroy() end
        if bg then bg:Destroy() end
        bv = Instance.new("BodyVelocity")
        bv.MaxForce = Vector3.new(9e9, 9e9, 9e9)
        bv.Parent = root
        bg = Instance.new("BodyGyro")
        bg.MaxTorque = Vector3.new(9e9, 9e9, 9e9)
        bg.Parent = root
        fly = true
        print("FLY ON! Gas cuy!")
    else
        if bv then bv:Destroy() end
        if bg then bg:Destroy() end
        fly = false
        print("FLY OFF.")
    end
end

local dir = Vector3.new(0,0,0)

UIS.InputBegan:Connect(function(inp, gp)
    if gp then return end
    local k = inp.KeyCode
    if k == Enum.KeyCode.F then toggleFly(not fly) end
    if k == Enum.KeyCode.W then dir = dir + Vector3.new(0,0,-1) end
    if k == Enum.KeyCode.S then dir = dir + Vector3.new(0,0,1) end
    if k == Enum.KeyCode.A then dir = dir + Vector3.new(-1,0,0) end
    if k == Enum.KeyCode.D then dir = dir + Vector3.new(1,0,0) end
    if k == Enum.KeyCode.Space then dir = dir + Vector3.new(0,1,0) end
    if k == Enum.KeyCode.LeftShift then dir = dir + Vector3.new(0,-1,0) end
end)

UIS.InputEnded:Connect(function(inp, gp)
    if gp then return end
    local k = inp.KeyCode
    if k == Enum.KeyCode.W then dir = dir - Vector3.new(0,0,-1) end
    if k == Enum.KeyCode.S then dir = dir - Vector3.new(0,0,1) end
    if k == Enum.KeyCode.A then dir = dir - Vector3.new(-1,0,0) end
    if k == Enum.KeyCode.D then dir = dir - Vector3.new(1,0,0) end
    if k == Enum.KeyCode.Space then dir = dir - Vector3.new(0,1,0) end
    if k == Enum.KeyCode.LeftShift then dir = dir - Vector3.new(0,-1,0) end
end)

RS.RenderStepped:Connect(function()
    if fly and root and bv then
        local cam = workspace.CurrentCamera
        local f = cam.CFrame.LookVector
        local r = cam.CFrame.RightVector
        local u = cam.CFrame.UpVector
        bv.Velocity = (f * dir.Z * -1 + r * dir.X + u * dir.Y) * speed
        bg.CFrame = cam.CFrame
    end
end)

print("Skrip fly siap! Tekan F buat terbang.")
]])()
